# A Script whose carrier is deleted leaves an Orphaned Group, which a Draft brings back, and one without a Draft can't be
open-window
set-scripts-width 1
new-script Lights
set-text
power_display((1 & 1) | 1)
end
compile
expect-result Placed
expect-orphans 0
delete-carrier Lights
expect-orphans 0
save-level orphaned
load-level orphaned
expect-orphans 1
expect-orphan-result none
screenshot narrow
expect-step-fails restore-orphan Nope because no Orphaned Group is called "Nope"
restore-orphan Lights
expect-orphans 0
expect-text power_display((1 & 1) | 1)

load-level orphaned
expect-orphans 1
delete-drafts
expect-orphans 1
expect-step-fails restore-orphan Unnamed because has no Draft
expect-step-fails delete-drafts because no Orphaned Group has a Draft
expect-step-fails delete-carrier Lights because no Script named "Lights"
screenshot unnamed
expect-no-exceptions
