# F2 renames the name at the caret where it's defined and everywhere the Script uses it, in one undo step

open-window
new-script Rename
set-text
a = logic(1, 1)
b = logic(a, b: a)
power_display(b)
end
expect-no-errors

# The caret is on the first a; the prompt opens with it selected, so typing replaces it
caret-at-start
press f2
screenshot prompt
type count
press enter
expect-result Renamed "a" to "count" in 3 places
expect-text b = logic(count, b: count)

# Enter went to the prompt, so the editor got no line break
expect-text count = logic(1, 1)
expect-no-errors
screenshot renamed

# A name the Script already defines is refused, and the text stays
caret-at-start
press f2
type b
press enter
expect-text count = logic(1, 1)
screenshot refused
press escape

# Undo takes the whole rename back
caret-at-start
press ctrl+z
expect-text a = logic(1, 1)
expect-text b = logic(a, b: a)

compile
expect-result Placed 3 blocks
