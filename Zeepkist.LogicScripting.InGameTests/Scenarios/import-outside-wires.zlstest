# Logic between a trigger and a lamp imports with Placed Block References to both, and a Compile wires the lamp the same
open-window
place-block trigger as t
place-block generator as g
set-block-setting g power 5
place-block logic as l
set-block-setting l op or
place-block lamp as m
wire-blocks t out to l a
wire-blocks g out to l b
wire-blocks l out to m red
wire-blocks g out to m intensity
move-block t 0 0 32
move-block l 16 0 0
move-block m 48 0 0
remember-blocks t g l m
screenshot before

# The trigger and the lamp are selected too, and stay outside the Script. Names take the order the text uses them in
select-blocks t g l m
import-selected
expect-list-result Imported 2 blocks as "Imported". The next Compile replaces them with a new layout
expect-text trigger_1 = placed("
expect-text lamp_1 = placed("
expect-text lamp_1(5, trigger_1 | 5)
expect-no-errors
expect-blocks 4
expect-blocks-unmoved t g l m
expect-wire t out to l a
expect-wire g out to l b
expect-wire l out to m red
expect-wire g out to m intensity
expect-wires m 2
screenshot imported

# The Compile's blocks have the same Wires to the trigger and the lamp
compile
expect-result Replaced 2 → 2 blocks
expect-blocks 4
name-group-block Imported generator as g2
name-group-block Imported logic as l2
expect-wire t out to l2 a
expect-wire g2 out to l2 b
expect-wire l2 out to m red
expect-wire g2 out to m intensity
expect-wires m 2
expect-wires t 1
expect-blocks-unmoved t m
screenshot compiled

# One undo takes the Compile back, another the import, and neither changes the lamp
undo
wait 1
expect-blocks 4
expect-blocks-unmoved t g l m
expect-wire t out to l a
expect-wire g out to l b
expect-wire l out to m red
expect-wire g out to m intensity
expect-wires m 2
undo
wait 1
expect-blocks 4
expect-blocks-unmoved t g l m
expect-wire t out to l a
expect-wire g out to l b
expect-wire l out to m red
expect-wire g out to m intensity
expect-wires m 2
select-group Imported
expect-list-result "Imported" has no blocks in the level

# A block on its own imports too, with its Wires to blocks that aren't selected
open-delete Imported
press-prompt delete
select-blocks l
import-selected
expect-list-result Imported 1 block as "Imported"
expect-text trigger_1 = placed("
expect-text generator_1 = placed("
expect-text lamp_1(red: trigger_1 | generator_1)
expect-no-errors
compile
expect-result Replaced 1 → 1 block
expect-blocks 4
name-group-block Imported logic as l3
expect-wire t out to l3 a
expect-wire g out to l3 b
expect-wire l3 out to m red
expect-wire g out to m intensity
expect-wires m 2

# Another import can't refer to a block in this Script's Block Group
select-blocks g
expect-step-fails import-selected because has a Wire to logic "
expect-step-fails import-selected because but that one is in a Block Group
expect-no-exceptions
